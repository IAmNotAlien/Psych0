# PSYCH0 / PSYCH://OS — environment variables
# Copy to .env for local dev, or set these in Vercel → Settings → Environment Variables.
# NEVER commit your real .env — it is gitignored.

# ── Supabase (required for PERSISTENT mode; omit → LOCAL MODE, browser-only data) ──
# Supabase → Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# the sb_secret_… key — bypasses RLS, SERVER ONLY, never expose in the browser
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY_HERE

# ── AI / brain (optional — unlocks the OS brain, OCR, flashcards, reviews) ──
# OpenRouter free tier works: https://openrouter.ai → keys start sk-or-
OPENROUTER_API_KEY=
# Optional pinning (defaults: openrouter/free, auto-router)
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_VISION_MODEL=

# ── Studio (optional) ──
# Studio passcode; the app ships with a code fallback you can change here
STUDIO_PASSCODE=
# Teleport capture (optional): Telegram bot relay
# TELEGRAM_BOT_TOKEN=

# ── Site metadata (optional) ──
# Absolute site URL used by sitemap/robots/OG cards, e.g. https://your-domain
NEXT_PUBLIC_SITE_URL=
